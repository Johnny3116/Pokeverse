{
  "name": "pokeverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite",
    "dev:server": "bun --watch server/index.ts",
    "vendor": "bun scripts/vendor-emulator.ts",
    "build": "bun scripts/vendor-emulator.ts && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "test": "vitest run && bun test server",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@emulatorjs/core-mgba": "4.2.3",
    "@emulatorjs/emulatorjs": "4.2.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.575.0",
    "marked": "^18.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "playwright-core": "^1.56.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "rolldown": "1.2.1"
  }
}
