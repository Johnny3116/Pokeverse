# Files that run inside the Linux container must keep LF line endings, even when the
# repo is checked out on Windows (core.autocrlf would otherwise break the shebangs).
* text=auto
*.sh text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.gba binary
*.jpg binary
*.png binary
*.ico binary
